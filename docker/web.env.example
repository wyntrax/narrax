# Save as /srv/narrax/.env.web ON THE HOST, separately from the backend .env.
# First four values must EXACTLY match GitHub WEB_* build variables (including optional empty URL).
NEXT_PUBLIC_SITE_URL=https://YOUR-WEB-HOST
NEXT_PUBLIC_API_URL=https://YOUR-API-HOST
NEXT_PUBLIC_PRIVY_APP_ID=YOUR-PUBLIC-PRIVY-APP-ID
NEXT_PUBLIC_WYNTRAX_URL=
# Keep false until domain/TLS/content and search launch checks are complete.
NARRA_SEO_INDEXABLE=false
# Paste only Google's token value, not the "google-site-verification=" prefix.
# These runtime values take effect after recreating the frontend container.
NARRA_GOOGLE_SITE_VERIFICATION=
NARRA_BING_SITE_VERIFICATION=
