# Fill locally; never commit an actual env file. NARRA_* settings below are server-only.
# Same-VPS production delivery: docs/FRONTEND_DEPLOYMENT.md and docker/web.env.example.
# Local API: http://localhost:4000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_WYNTRAX_URL=
# Canonical public web origin; local web: http://localhost:4010
NEXT_PUBLIC_SITE_URL=
# Enable only on the canonical, public HTTPS production site after launch review.
# Leave false on localhost, previews and staging. Run the web launcher with these in its process environment.
NARRA_SEO_INDEXABLE=false
# Optional public ownership-verification tokens (not API keys).
NARRA_GOOGLE_SITE_VERIFICATION=
NARRA_BING_SITE_VERIFICATION=
# Configure on the API (not here): CORS_ORIGINS=http://localhost:4010
# Admin setting: entitlements.wallet_link_domain=http://localhost:4010
# Privy dashboard allowed origin: http://localhost:4010
