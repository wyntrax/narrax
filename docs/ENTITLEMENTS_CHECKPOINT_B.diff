+++ b/apps/api/src/entitlements/webhook.test.ts
@@ -0,0 +1,73 @@
+import { createHmac, randomUUID } from 'node:crypto';
+import Fastify from 'fastify';
+import rateLimit from '@fastify/rate-limit';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { createPrisma } from '@narra/database';
+import { registerHttpHardening } from '../http';
+import { registerWyntraxWebhook, type WyntraxDeps } from './webhook';
+import { VECTOR_BODY, VECTOR_SECRET, VECTOR_SIGNATURE, VECTOR_TIME } from './fixtures.test-support';
+
+const url = new URL(process.env.DATABASE_URL ?? 'invalid:');
+if (url.hostname !== 'localhost' || url.port !== '5432' || url.pathname !== '/narra_ent') throw new Error('Require scratch database');
+const db = createPrisma(url.toString());
+const tag = `wh-${randomUUID()}`;
+const now = new Date(Number(VECTOR_TIME) * 1000);
+let seq = 0;
+const ids: string[] = [], members: string[] = [];
+const signBody = (body: string) => 'v1=' + createHmac('sha256', VECTOR_SECRET).update(VECTOR_TIME + '.').update(body).digest('hex');
+const payload = () => { const e = JSON.parse(VECTOR_BODY); e.id = `${tag}-${++seq}`; e.data.wyntraxUserId = `${tag}-member-${seq}`; ids.push(e.id); members.push(e.data.wyntraxUserId); return e; };
+async function appFor(overrides: Partial<WyntraxDeps> = {}) {
+  const app = Fastify({ logger: false });
+  await registerHttpHardening(app);
+  await app.register(rateLimit, { global: false });
+  await registerWyntraxWebhook(app, { db, secret: VECTOR_SECRET, now: () => now, ...overrides });
+  return app;
+}
+let app: Awaited<ReturnType<typeof appFor>>;
+beforeAll(async () => { app = await appFor(); });
+afterAll(async () => {
+  await app.close();
+  await db.webhookEvent.deleteMany({ where: { id: { in: ids } } });
+  await db.wyntraxMembership.deleteMany({ where: { wyntraxUserId: { in: members } } });
+  await db.auditLog.deleteMany({ where: { OR: [{ detail: { path: ['wyntraxUserId'], string_starts_with: tag } }, { detail: { path: ['eventId'], string_starts_with: tag } }] } });
+  await db.$disconnect();
+});
+const inject = (body: string, id: string, overrides: Record<string, string> = {}, server = app, remoteAddress = `127.0.0.${++seq % 200 + 1}`) => server.inject({ method: 'POST', url: '/v1/integrations/wyntrax/events', remoteAddress, payload: body,
+  headers: { 'content-type': 'application/json', 'x-wyntrax-timestamp': VECTOR_TIME, 'x-wyntrax-event-id': id, 'x-wyntrax-signature': signBody(body), ...overrides } });
+describe('webhook HTTP boundary with real scratch persistence', () => {
+  it('raw bytes before parsing; contract response, duplicate and header identity', async () => {
+    const e = payload(), body = JSON.stringify(e);
+    const applied = await inject(body, e.id); expect(applied.statusCode).toBe(200); expect(applied.json()).toEqual({ ok: true, status: 'applied' });
+    expect((await inject(body, e.id)).json()).toEqual({ ok: true, status: 'duplicate' });
+    expect((await inject(body, 'wrong')).statusCode).toBe(400);
+    expect((await inject(body + ' ', e.id, { 'x-wyntrax-signature': signBody(body) })).statusCode).toBe(401);
+    const spaced = payload(); expect((await inject(JSON.stringify(spaced, null, 2), spaced.id)).statusCode).toBe(200);
+  });
+  it('accepts previous secret during rotation and does not use Privy auth', async () => {
+    const rotated = await appFor({ secret: 'rotated', previousSecret: VECTOR_SECRET });
+    try { const e = payload(); expect((await inject(JSON.stringify(e), e.id, {}, rotated)).statusCode).toBe(200); } finally { await rotated.close(); }
+  });
+  it('missing primary returns 503 even with previous secret, never 404/500', async () => {
+    const missing = await appFor({ secret: undefined, previousSecret: VECTOR_SECRET });
+    try { expect((await inject(VECTOR_BODY, 'evt_test_0001', { 'x-wyntrax-signature': VECTOR_SIGNATURE }, missing)).statusCode).toBe(503); } finally { await missing.close(); }
+  });
+  it('returns 401 for missing signature/timestamp and 400 for malformed signed JSON/media/id', async () => {
+    const e = payload(), body = JSON.stringify(e);
+    for (const field of ['x-wyntrax-timestamp', 'x-wyntrax-signature']) expect((await inject(body, e.id, { [field]: '' })).statusCode).toBe(401);
+    expect((await inject(body, e.id, { 'x-wyntrax-event-id': '' })).statusCode).toBe(400);
+    for (const malformed of ['{bad', 'null', '[]']) expect((await inject(malformed, e.id)).statusCode).toBe(400);
+    expect((await inject(body, e.id, { 'content-type': 'text/plain' })).statusCode).toBe(400);
+    expect((await inject(body, e.id, { 'content-encoding': 'gzip' })).statusCode).toBe(400);
+    expect(await db.webhookEvent.findUnique({ where: { id: e.id } })).toBeNull();
+  });
+  it('16KB limit returns 413 before parsing/persistence and rate limit returns 429', async () => {
+    expect((await inject('x'.repeat(16385), 'oversize')).statusCode).toBe(413);
+    let last;
+    for (let i = 0; i < 121; i++) last = await inject('{}', 'limited', {}, app, '192.0.2.99');
+    expect(last!.statusCode).toBe(429); expect(last!.json().error).toBe('RATE_LIMITED');
+  });
+  it('storage failure is sanitized 503 without saving an event', async () => {
+    const failed = await appFor({ db: { $transaction: async () => { throw Error('private failure details'); } } as never });
+    try { const e = payload(); const response = await inject(JSON.stringify(e), e.id, {}, failed); expect(response.statusCode).toBe(503); expect(response.body).not.toContain('private'); } finally { await failed.close(); }
+  });
+});
diff --git a/apps/api/src/entitlements/webhook.ts b/apps/api/src/entitlements/webhook.ts
new file mode 100644
index 0000000..588d8af
--- /dev/null
+++ b/apps/api/src/entitlements/webhook.ts
@@ -0,0 +1,43 @@
+import type { FastifyInstance } from 'fastify';
+import type { PrismaClient } from '@narra/database';
+import { authenticateWyntrax, WyntraxEvent } from './wyntrax';
+import { hash } from './crypto';
+import { applyWyntraxEvent } from './membershipStore';
+
+export interface WyntraxDeps { db?: PrismaClient; secret?: string; previousSecret?: string; now?: () => Date }
+export async function registerWyntraxWebhook(app: FastifyInstance, deps: WyntraxDeps = {}) {
+  await app.register(async scoped => {
+    scoped.removeAllContentTypeParsers();
+    // Parsing JSON happens only after the exact raw bytes have passed authentication.
+    scoped.addContentTypeParser('*', { parseAs: 'buffer', bodyLimit: 16384 }, (_req, body, done) => done(null, body));
+    scoped.post('/v1/integrations/wyntrax/events', {
+      bodyLimit: 16384, config: { rateLimit: { max: 120, timeWindow: '1 minute', groupId: 'wyntrax-webhook' } },
+      onRequest: async (req, reply) => {
+        if (!deps.secret || !deps.db) return reply.code(503).send({ error: 'WYNTRAX_UNAVAILABLE', requestId: req.requestId });
+      },
+    }, async (req, reply) => {
+      const fail = (status: number, error: string) => reply.code(status).send({ error, requestId: req.requestId });
+      const now = (deps.now ?? (() => new Date()))();
+      const raw = req.body;
+      if (!Buffer.isBuffer(raw)) return fail(400, 'INVALID_INPUT');
+      const timestamp = req.headers['x-wyntrax-timestamp'], signature = req.headers['x-wyntrax-signature'];
+      // Node can coalesce duplicate headers; reject their raw occurrences too.
+      const names = req.raw.rawHeaders.filter((_v, i) => i % 2 === 0).map(s => s.toLowerCase());
+      if (['x-wyntrax-timestamp', 'x-wyntrax-signature', 'x-wyntrax-event-id'].some(h => names.filter(n => n === h).length > 1)) return fail(401, 'UNAUTHORIZED');
+      if (!authenticateWyntrax(raw, { timestamp, signature }, deps, now)) return fail(401, 'UNAUTHORIZED');
+      if (!/^application\/json(?:\s*;\s*charset=utf-8)?$/i.test(req.headers['content-type'] ?? '') || req.headers['content-encoding']) return fail(400, 'INVALID_INPUT');
+      let json: unknown;
+      try { json = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(raw)); } catch { return fail(400, 'INVALID_INPUT'); }
+      const parsed = WyntraxEvent.safeParse(json);
+      if (!parsed.success || typeof req.headers['x-wyntrax-event-id'] !== 'string' || parsed.data.id !== req.headers['x-wyntrax-event-id']) return fail(400, 'INVALID_INPUT');
+      try {
+        const status = await applyWyntraxEvent(deps.db!, parsed.data, hash(raw), now);
+        return { ok: true, status };
+      } catch {
+        // Do not serialize provider payloads, Prisma arguments, secrets or signatures into error logs.
+        req.log.error({ code: 'WYNTRAX_STORAGE_FAILURE', requestId: req.requestId }, 'membership update unavailable');
+        return fail(503, 'WYNTRAX_UNAVAILABLE');
+      }
+    });
+  });
+}
diff --git a/apps/api/src/entitlements/wyntrax.ts b/apps/api/src/entitlements/wyntrax.ts
new file mode 100644
index 0000000..11d9b75
--- /dev/null
+++ b/apps/api/src/entitlements/wyntrax.ts
@@ -0,0 +1,28 @@
+import { createHmac, timingSafeEqual } from 'node:crypto';
+import { z } from 'zod';
+import { WalletInput } from './common';
+
+export const WyntraxData = z.object({
+  wyntraxUserId: z.string().min(1).max(16384), wallets: z.array(WalletInput).max(10),
+  tier: z.enum(['NONE', 'MEMBER', 'PRO', 'ELITE']), validUntil: z.string().datetime({ offset: true }).nullable().optional(),
+  balanceSnapshotAt: z.string().datetime({ offset: true }),
+}).strict().refine(d => d.tier === 'NONE' || d.validUntil != null, { path: ['validUntil'] });
+export const WyntraxEvent = z.object({
+  id: z.string().min(1).max(16384), type: z.literal('membership.updated'),
+  occurredAt: z.string().datetime({ offset: true }), version: z.number().int().safe(), data: WyntraxData,
+}).strict();
+export type WyntraxEvent = z.infer<typeof WyntraxEvent>;
+export function authenticateWyntrax(raw: Buffer, headers: { timestamp?: unknown; signature?: unknown }, secrets: { secret?: string; previousSecret?: string }, now: Date): boolean {
+  const { timestamp, signature } = headers;
+  if (!secrets.secret || typeof timestamp !== 'string' || !/^[0-9]{1,16}$/.test(timestamp) || typeof signature !== 'string' || !/^v1=[a-f0-9]{64}$/.test(signature)) return false;
+  const seconds = Number(timestamp);
+  if (!Number.isSafeInteger(seconds) || !Number.isFinite(now.getTime()) || Math.abs(now.getTime() / 1000 - seconds) > 300) return false;
+  const received = Buffer.from(signature.slice(3), 'hex');
+  const check = (secret: string) => {
+    const expected = createHmac('sha256', secret).update(timestamp).update('.').update(raw).digest();
+    return received.length === expected.length && timingSafeEqual(received, expected);
+  };
+  const primary = check(secrets.secret);
+  const previous = secrets.previousSecret ? check(secrets.previousSecret) : false;
+  return primary || previous;
+}
