@@ -0,0 +1,43 @@
+import type { PrismaClient } from '@narra/database';
+import { audit, lock, TX_OPTIONS } from './common';
+import { WyntraxEvent } from './wyntrax';
+
+export interface IncomingMembership {
+  wyntraxUserId: string; version: number; tier: 'NONE' | 'MEMBER' | 'PRO' | 'ELITE';
+  wallets: { chain: 'solana'; address: string }[]; validUntil: Date | null;
+  balanceSnapshotAt: Date | null; sourceUpdatedAt: Date;
+}
+/** Shared transaction boundary for authenticated webhook and (Stage 5) validated partner states. */
+export async function applyMembershipState(db: PrismaClient, state: IncomingMembership, now: Date, receipt?: { id: string; bodyHash: string; occurredAt: Date }) {
+  return db.$transaction(async tx => {
+    // Event lock first ensures even an ID reused across members cannot race the global unique key.
+    if (receipt) await lock(tx, `event:${receipt.id}`);
+    await lock(tx, `member:${state.wyntraxUserId}`);
+    if (receipt) {
+      const prior = await tx.webhookEvent.findUnique({ where: { id: receipt.id } });
+      if (prior) {
+        if (prior.bodyHash !== receipt.bodyHash) await audit(tx, null, 'entitlements.event_collision', { eventId: receipt.id });
+        return 'duplicate' as const;
+      }
+    }
+    const previous = await tx.wyntraxMembership.findUnique({ where: { wyntraxUserId: state.wyntraxUserId }, select: { version: true } });
+    const status = previous && BigInt(state.version) <= previous.version ? 'stale' as const : 'applied' as const;
+    if (status === 'applied') {
+      const { wallets, ...data } = state;
+      const value = { ...data, version: BigInt(state.version), receivedAt: now, lastEventId: receipt?.id ?? null, lastTransport: receipt ? 'WEBHOOK' : 'RECONCILE' };
+      await tx.wyntraxMembership.upsert({ where: { wyntraxUserId: state.wyntraxUserId }, create: value, update: value });
+      await tx.wyntraxMembershipWallet.deleteMany({ where: { wyntraxUserId: state.wyntraxUserId } });
+      await tx.wyntraxMembershipWallet.createMany({ data: wallets.map(w => ({ ...w, wyntraxUserId: state.wyntraxUserId })), skipDuplicates: true });
+    }
+    if (receipt) await tx.webhookEvent.create({ data: { ...receipt, wyntraxUserId: state.wyntraxUserId, version: BigInt(state.version), receivedAt: now, outcome: status.toUpperCase() } });
+    await audit(tx, null, `entitlements.membership_${status}`, { wyntraxUserId: state.wyntraxUserId, version: state.version, tier: state.tier, eventId: receipt?.id ?? null, transport: receipt ? 'WEBHOOK' : 'RECONCILE' });
+    return status;
+  }, TX_OPTIONS);
+}
+export function applyWyntraxEvent(db: PrismaClient, input: unknown, bodyHash: string, now: Date) {
+  const event = WyntraxEvent.parse(input);
+  return applyMembershipState(db, { ...event.data, version: event.version,
+    validUntil: event.data.validUntil ? new Date(event.data.validUntil) : null,
+    balanceSnapshotAt: new Date(event.data.balanceSnapshotAt), sourceUpdatedAt: new Date(event.occurredAt) }, now,
+  { id: event.id, bodyHash, occurredAt: new Date(event.occurredAt) });
+}
diff --git a/apps/api/src/entitlements/settings.ts b/apps/api/src/entitlements/settings.ts
new file mode 100644
index 0000000..7209f60
--- /dev/null
+++ b/apps/api/src/entitlements/settings.ts
@@ -0,0 +1,45 @@
+import type { Prisma, PrismaClient } from '@narra/database';
+import { z } from 'zod';
+import { sanitizeUntrusted } from '@narra/shared';
+import { AccessError, audit, lock, requireAdminActor, TX_OPTIONS } from './common';
+
+const Domain = z.string().max(256).refine(value => {
+  try { const u = new URL(value); return u.origin === value && !u.username && !u.password && (u.protocol === 'https:' || (u.protocol === 'http:' && u.hostname === 'localhost' && u.port === '4010')); } catch { return false; }
+});
+export const SETTING_SCHEMAS = {
+  'early_access.enabled': z.boolean(),
+  'early_access.seat_cap': z.number().int().nonnegative().safe(),
+  'early_access.invite_required': z.boolean(),
+  'entitlements.wallet_link_domain': Domain,
+} as const;
+type SettingKey = keyof typeof SETTING_SCHEMAS;
+export async function localSettings(tx: Pick<Prisma.TransactionClient, 'systemSetting'>) {
+  const rows = await tx.systemSetting.findMany({ where: { key: { in: Object.keys(SETTING_SCHEMAS) } } });
+  const values: Record<string, unknown> = { 'early_access.enabled': false, 'early_access.seat_cap': 0, 'early_access.invite_required': false };
+  for (const r of rows) {
+    const parsed = SETTING_SCHEMAS[r.key as SettingKey].safeParse(r.value);
+    if (!parsed.success) throw new AccessError('ENTITLEMENTS_UNAVAILABLE', 503);
+    values[r.key] = parsed.data;
+  }
+  return { enabled: values['early_access.enabled'] as boolean, cap: values['early_access.seat_cap'] as number, inviteRequired: values['early_access.invite_required'] as boolean, domain: values['entitlements.wallet_link_domain'] as string | undefined };
+}
+/** Internal service for Stage 4's admin routes. Only these exact keys can ever be written. */
+export async function updateLocalSettings(db: PrismaClient, actorId: string, input: unknown, reasonInput: string) {
+  const parsed = z.object(SETTING_SCHEMAS).partial().strict().safeParse(input);
+  const reason = sanitizeUntrusted(reasonInput, 300).trim();
+  if (!parsed.success || !reason) throw new AccessError('INVALID_INPUT', 400);
+  return db.$transaction(async tx => {
+    await requireAdminActor(tx, actorId);
+    await lock(tx, 'seats');
+    // The same domain lock is held while creating/verifying proofs.
+    await lock(tx, 'domain');
+    for (const [key, value] of Object.entries(parsed.data)) {
+      const before = await tx.systemSetting.findUnique({ where: { key } });
+      if (key === 'entitlements.wallet_link_domain' && before?.value !== value) {
+        await tx.walletLinkChallenge.updateMany({ where: { consumedAt: null }, data: { consumedAt: new Date() } });
+      }
+      await tx.systemSetting.upsert({ where: { key }, create: { key, value }, update: { value } });
+      await audit(tx, actorId, 'entitlements.setting_changed', { key, before: before?.value ?? null, after: value, reason });
+    }
+  }, TX_OPTIONS);
+}
