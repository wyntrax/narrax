# Brand (placeholder, change freely)
PROJECT_NAME=NARRAX

# User-approved Solana mainnet swaps. Requires JUPITER_API_KEY, mainnet HELIUS_RPC_URL,
# the manual_swaps migration and a verified linked wallet. Does not enable the automated executor.
MANUAL_TRADING_ENABLED=false

# Data stores
DATABASE_URL=postgresql://narra:narra@localhost:5432/narra
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000

# Who is an admin. When either is set, the server environment is the single source of truth: exactly these accounts are
# admin and any leftover database isAdmin flag on another user is ignored. When both are empty, the database flag is
# used instead (local development and tests). Set both if you can.
#
# ADMIN_PRIVY_USER_ID is the did:privy:... id from the verified sign-in token, so it cannot be claimed by typing it in.
# Find yours by signing in once, then either read it on the Admin page or run: npm run make-admin -- --list
ADMIN_PRIVY_USER_ID=
# ADMIN_EMAIL matches the address in a Privy-signed identity token and is lowercased before comparing.
# Only a signature-verified email counts; an address typed into the browser is never trusted.
ADMIN_EMAIL=

# Server-side secrets only. Never expose these to the browser.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional Helius integration credential.
HELIUS_API_KEY=
AI_PROVIDER_API_KEY=
# OpenAI-compatible provider, used by the agent chat and the analysis pipeline. Defaults to Vikey.
AI_BASE_URL=https://api.vikey.ai/v1
# A model id your provider lists for this key. Used until admin AI settings are saved (saved settings win).
AI_MODEL_ID=
# standard (default): model, messages, temperature, max_tokens. bare: only model and messages. full: also JSON mode and reasoning_effort.
AI_REQUEST_STYLE=standard
HELIUS_WEBHOOK_SECRET=
JUPITER_API_KEY=
PRIVY_VERIFICATION_KEY=
HELIUS_RPC_URL=
# Optional discovery-only secondary Solana mainnet RPC URL (full URL with second key).
# Used on primary HTTP 429; shares discovery's existing request/retry budget.
# Example: https://mainnet.helius-rpc.com/?api-key=YOUR_SECOND_KEY
HELIUS_RPC_FALLBACK_URL=

# GMGN public-feed research setup (integration not enabled or wired yet).
# Run gmgn-cli config, then open its public-key link to create an API key on GMGN.
# Put only the API key here; never copy keypair.pem or GMGN_PRIVATE_KEY into this repo or launchers.
# PowerShell launcher equivalent: $env:GMGN_API_KEY = "<your-api-key>"
# Keep real .env / local-api.ps1 / local-web.ps1 files ignored and out of Docker images.
GMGN_API_KEY=

# Market data (free public APIs, no key needed). Both limits are per process.
MARKET_DATA_ENABLED=true
# Optional overrides, for example to point at a paid or proxied endpoint
DEXSCREENER_BASE_URL=
GECKOTERMINAL_BASE_URL=

# Tracked-wallet webhook sync. The URL is the public address of POST /webhooks/helius on your API.
# The secret is sent back by Helius in the Authorization header and checked by the API.
HELIUS_WEBHOOK_URL=

# Wallet-flow research (off by default). Research rows only: no alerts, AI jobs, orders or positions.
# SMART_MONEY_RESEARCH_ENABLED enables bounded flow publication and 1h/4h/24h measurements.
# SMART_MONEY_HISTORY_ENABLED independently enables candidate intake (2/cycle, 200 discovered cap)
# and resumable Helius history (2 wallets x 3 pages/cycle); needs HELIUS_API_KEY.
# It does not enable research publication or approve discovered wallets.
SMART_MONEY_RESEARCH_ENABLED=false
SMART_MONEY_HISTORY_ENABLED=false

# API hardening and realtime (B7)
# Exact browser origins allowed to call the API and open the WebSocket, comma separated. Empty means no cross-origin access.
CORS_ORIGINS=
# Set true only when the API runs behind a reverse proxy you control (it makes rate limits use the client address).
TRUST_PROXY=false
# Set true only when the API is served over HTTPS.
HSTS=false
# Name of the Redis stream that carries realtime events.
REALTIME_STREAM_KEY=narra:events

# Executor (B5a, dry run only). The executor cannot sign or send, and refuses to start if a signing key variable is set.
EXECUTOR_MODE=dry_run
# User ids (comma separated) whose AUTO or confirmed orders are dry-run. Empty means nobody.
EXECUTOR_ALLOWLIST_USER_IDS=
# Starting values (approved canary defaults). Each has a built-in ceiling in workers/executor/src/config.ts; a value above it stops startup.
EXECUTOR_HARD_CAP_SOL=0.01
EXECUTOR_DAILY_CAP_SOL=0.05
EXECUTOR_MAX_OVERHEAD_SOL=0.005
EXECUTOR_MAX_PRIORITY_FEE_SOL=0.001
EXECUTOR_BROADCAST_WINDOW_MS=10000
# Wyntrax membership webhooks. Copy the creator signing secret from a membership.
# Receiver keys: MEMBER, PRO, ELITE; chain: solana.
WYNTRAX_WEBHOOK_SECRET=
WYNTRAX_WEBHOOK_SECRET_PREVIOUS=
# Optional outbound membership receiver. When both are set, the pipeline worker posts signed
# membership.granted / membership.revoked events for wallets that hold the configured $WYNTRAX mint.
WYNTRAX_MEMBERSHIP_WEBHOOK_URL=
WYNTRAX_MEMBERSHIP_WEBHOOK_SECRET=

# Early Radar safety gate. shadow = record the verdict, publish with a visible safety line and expose it in
# radar:status; enforce = withhold every non-PASS call; off = legacy behavior (tests/debug only).
# A PASS requires LP, dev, bundle/sniper/insider, unique-buyer and price-impact evidence that the free sources
# do not currently provide, so the expected production state is shadow with explicit UNKNOWN verdicts.
RADAR_SAFETY_MODE=shadow
# Safety evidence enrichment for early-radar candidates. rugcheck is public (no key); off disables it.
# The source is bounded (3 candidates per run by default), cached for 10 minutes, and every failure is UNKNOWN.
RADAR_SAFETY_EVIDENCE=rugcheck
RADAR_SAFETY_EVIDENCE_MAX_PER_RUN=3
# Optional override for the public RugCheck API origin.
RUGCHECK_BASE_URL=https://api.rugcheck.xyz
# Tradeability evidence: one live Jupiter quote for a $50 USDC buy, recorded as the price-impact fact.
# Bounded to 3 quotes per run, cached for 10 minutes; failures stay UNKNOWN. off disables it.
RADAR_TRADEABILITY_EVIDENCE=on
RADAR_TRADEABILITY_MAX_PER_RUN=3

# Telegram Early Radar delivery (global research alerts only; no user-owned alerts, orders or positions).
# Leave the token and chat id empty to disable delivery. The CLI defaults to a dry run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional delivery limits. Set TELEGRAM_ENABLED=false to disable without removing the credentials.
TELEGRAM_MAX_AGE_MIN=15
TELEGRAM_MAX_PER_RUN=10
TELEGRAM_SEND_DELAY_MS=1200
# Service-status notice after 2h without Early Radar alerts, at most once per 6h/chat.
# Does not relax alert freshness. Set false to disable status notices only.
TELEGRAM_HEALTH_NOTICES=true
# Bounded finalized Solana holder enumeration through HELIUS_RPC_URL: 2 tokens/market cycle.
# Four RPC requests per successful token; 15s/token, 2 MiB/response, 5000 accounts maximum.
# Complete supply reconciliation and block-time provenance required. Set false to disable.
HOLDER_RPC_FALLBACK_ENABLED=true
# Market-run top-up for price-lane tokens outside the radar cohort (1..40, 5..120s).
HOLDER_RPC_FALLBACK_PER_RUN=2
HOLDER_RPC_FALLBACK_DEADLINE_MS=15000
# Dedicated radar-cohort holder refresh, once a minute (1..12, 5..60s).
HOLDER_RPC_COHORT_PER_RUN=3
HOLDER_RPC_COHORT_DEADLINE_MS=20000

