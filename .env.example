# Brand (placeholder, change freely)
PROJECT_NAME=NARRA

# Data stores
DATABASE_URL=postgresql://narra:narra@localhost:5432/narra
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000

# Server-side secrets only. Never expose these to the browser.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
HELIUS_API_KEY=
AI_PROVIDER_API_KEY=
HELIUS_WEBHOOK_SECRET=
JUPITER_API_KEY=
PRIVY_VERIFICATION_KEY=
HELIUS_RPC_URL=

# Market data (free public APIs, no key needed). Both limits are per process.
MARKET_DATA_ENABLED=true
# Optional overrides, for example to point at a paid or proxied endpoint
DEXSCREENER_BASE_URL=
GECKOTERMINAL_BASE_URL=

# Tracked-wallet webhook sync. The URL is the public address of POST /webhooks/helius on your API.
# The secret is sent back by Helius in the Authorization header and checked by the API.
HELIUS_WEBHOOK_URL=

# API hardening and realtime (B7)
# Exact browser origins allowed to call the API and open the WebSocket, comma separated. Empty means no cross-origin access.
CORS_ORIGINS=
# Set true only when the API runs behind a reverse proxy you control (it makes rate limits use the client address).
TRUST_PROXY=false
# Set true only when the API is served over HTTPS.
HSTS=false
# Name of the Redis stream that carries realtime events.
REALTIME_STREAM_KEY=narra:events

# Executor (B5a, dry run only). The executor cannot sign or send, and refuses to start if a signing key variable is set.
EXECUTOR_MODE=dry_run
# User ids (comma separated) whose AUTO or confirmed orders are dry-run. Empty means nobody.
EXECUTOR_ALLOWLIST_USER_IDS=
# Starting values (approved canary defaults). Each has a built-in ceiling in workers/executor/src/config.ts; a value above it stops startup.
EXECUTOR_HARD_CAP_SOL=0.01
EXECUTOR_DAILY_CAP_SOL=0.05
EXECUTOR_MAX_OVERHEAD_SOL=0.005
EXECUTOR_MAX_PRIORITY_FEE_SOL=0.001
EXECUTOR_BROADCAST_WINDOW_MS=10000
# Wyntrax membership webhooks. Copy the creator signing secret from a membership.
# Receiver keys: MEMBER, PRO, ELITE; chain: solana.
WYNTRAX_WEBHOOK_SECRET=
WYNTRAX_WEBHOOK_SECRET_PREVIOUS=
